{
  "ruleId": "security/hardcoded-secret",
  "category": "Security",
  "severity": "critical",
  "flags": "gi",
  "pattern": "(api[_-]?key|apikey|secret|password|credential|auth[_-]?(?:key|token)|private[_-]?key)\\s*([:=])\\s*['\"]([^'\"]{12,})['\"]",
  "fix": "$1$2 process.env.$U1",
  "confidence": "pilot"
}
