{
  "ruleId": "security/hardcoded-secret",
  "category": "Security",
  "severity": "critical",
  "flags": "gi",
  "confidence": "pilot",
  "pattern": "(api[_-]?key|apikey|secret|password|credential|auth[_-]?(?:key|token)|private[_-]?key)(\\s*[:=]\\s*)['\"]([^'\"]{12,})['\"]",
  "fix": "$1$2process.env.$U1",
  "aliases": [
    "hardcoded-secret",
    "secret/hardcoded",
    "security/secret"
  ],
  "description": "Detect hardcoded API keys, secrets, passwords, or tokens and replace with environment variable references.",
  "tags": [
    "security",
    "credentials",
    "cwe-798"
  ]
}
