{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X185PlusForgeRepairRule",
  "type": "object",
  "required": ["ruleId", "description", "severity", "confidence"],
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 5
    },
    "pattern": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    },
    "handler": {
      "type": "string",
      "enum": ["unused-import-line", "prefer-const-line"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "confidence": {
      "type": "string",
      "enum": ["local-proven", "local-unproven", "pilot", "gold"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "category": {
      "type": "string"
    },
    "flags": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
