{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x185plus/x185plus-forge/schema/repair-rule.schema.json",
  "title": "X185Plus Repair Rule",
  "description": "A deterministic regex-based repair rule for the X185Plus scanner.",
  "type": "object",
  "required": ["ruleId", "pattern", "fix", "severity", "category"],
  "properties": {
    "ruleId": {
      "type": "string",
      "description": "Must match detector finding.ruleId exactly (e.g. security/hardcoded-secret)."
    },
    "pattern": {
      "type": "string",
      "description": "JavaScript RegExp source (not /delimited/)."
    },
    "fix": {
      "type": "string",
      "description": "Replacement string. $1..$9 for capture groups; $U1 = uppercase group 1."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "category": {
      "type": "string",
      "description": "Display category (e.g. Security, Quality, Performance)."
    },
    "flags": {
      "type": "string",
      "description": "Regex flags. Default 'g'.",
      "default": "g"
    },
    "confidence": {
      "type": "string",
      "enum": ["pilot", "local-proven", "local-unproven", "gold"],
      "default": "pilot"
    },
    "goldRefusalReason": {
      "type": "string",
      "description": "Why Gold lane refused this pattern (if applicable)."
    },
    "mintedFrom": {
      "type": "string",
      "description": "Provenance: scan ID, Gold harvest ref, or github:path."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "proofGate": {
      "type": "object",
      "description": "Local Forge proof gate results.",
      "properties": {
        "parse": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
        "typeCheck": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
        "rescan": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] }
      },
      "required": ["parse", "typeCheck", "rescan"]
    }
  },
  "additionalProperties": false
}
